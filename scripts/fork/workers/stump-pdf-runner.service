# Runs Stump's PDF post-processing queue once and exits (see pdf_runner.py and README.md).
# Install as a user unit: cp stump-pdf-runner.{service,path} ~/.config/systemd/user/ &&
#   systemctl --user daemon-reload && systemctl --user enable --now stump-pdf-runner.path
[Unit]
Description=Stump PDF post-processing runner (OCR and size reduction of scanned PDFs)

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
Environment=STUMP_CONTAINER=stump-fork
Environment=BOOK_CURATOR=/mnt/data2/Code/book-curator
Environment=PDF_RUNNER_WORK=/mnt/nvme/Downloads/stump-pdf-runner
ExecStart=/mnt/data2/Code/book-curator/.venv/bin/python /mnt/data2/Code/stump/scripts/fork/workers/pdf_runner.py drain
