# Starts stump-pdf-runner.service when Stump queues a PDF. The path is the host side of the
# stump-fork container's /config mount; change it if the config lives elsewhere.
[Unit]
Description=Start the Stump PDF runner when a PDF is queued

[Path]
DirectoryNotEmpty=/mnt/data2/containers/stump-fork/config/workers/pdf/queue
MakeDirectory=true

[Install]
WantedBy=default.target
